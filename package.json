{
  "name": "project1",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:first": "nest start first-svc --watch",
    "start:auth-svc:dev": "nest start auth-svc --watch",
    "start:webhook:dev": "nest start rest-webhooks --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/project1/main",
    "auth-svc:start:dev": "nest start auth-svc --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "proto": "node buildProto.js",
    "mesh-start:graph:Porject1": "mesh dev --dir mesh/PROJECT1",
    "mesh-start:rest": "mesh dev start --dir mesh/PROJECT1/rest",
    "test:e2e": "jest --config ./apps/project1/test/jest-e2e.json",
    "build:lib": "yarn build assetes && yarn build common"
  },
  "dependencies": {
    "@graphql-mesh/cli": "^0.100.2",
    "@graphql-mesh/compose-cli": "^1.4.6",
    "@graphql-mesh/graphql": "^0.104.2",
    "@graphql-mesh/grpc": "^0.108.3",
    "@graphql-mesh/openapi": "^0.109.6",
    "@graphql-mesh/runtime": "^0.106.2",
    "@graphql-yoga/plugin-sofa": "^3.13.3",
    "@grpc/grpc-js": "^1.13.2",
    "@grpc/proto-loader": "^0.7.13",
    "@grpc/reflection": "^1.0.4",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/microservices": "^11.0.12",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.0.13",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.0.13",
    "@omnigraph/grpc": "^0.2.6",
    "axios": "^1.8.4",
    "class-validator": "^0.14.1",
    "colors": "^1.4.0",
    "dotenv": "^16.4.7",
    "google-protobuf": "^3.21.4",
    "graphql": "^16.10.0",
    "kafkajs": "^2.2.4",
    "mysql2": "^3.14.0",
    "nestjs-grpc-reflection": "^0.2.2",
    "pg": "^8.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-mixer": "^6.0.4",
    "ts-proto": "^2.7.5",
    "typeorm": "^0.3.22"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/assetes(|/.*)$": "<rootDir>/libs/assetes/src/$1",
      "^common/common(|/.*)$": "<rootDir>/libs/common/src/$1"
    }
  }
}
