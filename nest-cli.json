{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/project1/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/project1/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/project1",
  "projects": {
    "assetes": {
      "type": "library",
      "root": "libs/assetes",
      "entryFile": "index",
      "sourceRoot": "libs/assetes/src",
      "compilerOptions": {
        "tsConfigPath": "libs/assetes/tsconfig.lib.json"
      }
    },
    "auth-svc": {
      "type": "application",
      "root": "apps/auth-svc",
      "entryFile": "main",
      "sourceRoot": "apps/auth-svc/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-svc/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "first-svc": {
      "type": "application",
      "root": "apps/first-svc",
      "entryFile": "main",
      "sourceRoot": "apps/first-svc/src",
      "compilerOptions": {
        "tsConfigPath": "apps/first-svc/tsconfig.app.json"
      }
    },
    "project1": {
      "type": "application",
      "root": "apps/project1",
      "entryFile": "main",
      "sourceRoot": "apps/project1/src",
      "compilerOptions": {
        "tsConfigPath": "apps/project1/tsconfig.app.json"
      }
    },
    "rest-webhooks": {
      "type": "application",
      "root": "apps/rest-webhooks",
      "entryFile": "main",
      "sourceRoot": "apps/rest-webhooks/src",
      "compilerOptions": {
        "tsConfigPath": "apps/rest-webhooks/tsconfig.app.json"
      }
    },
    "second-svc": {
      "type": "application",
      "root": "apps/second-svc",
      "entryFile": "main",
      "sourceRoot": "apps/second-svc/src",
      "compilerOptions": {
        "tsConfigPath": "apps/second-svc/tsconfig.app.json"
      }
    }
  }
}